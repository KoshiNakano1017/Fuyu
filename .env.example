# 浮遊街アプリ 環境変数テンプレート（CLAUDE.md §3.2）
#
# ⚠️ このファイルは public リポジトリにコミットされる。
#    「キー名と説明」だけを書き、実値は絶対に書かない。
#    実値を書いてコミットすると、push した時点で取り消し不能になる（CLAUDE.md 冒頭の警告）。
#
# 使い方:
#   1. ローカル開発  … cp .env.example .env して、.env 側に実値を入れる（.env は .gitignore 済み）
#   2. CI / 自動化   … 実値は GitHub Secrets に入れる（下の「CI・自動化」節を参照）
#
# 取得状況の凡例:  [✓]=取得済み  [ ]=未取得（Phase 1 で必要）  [P2]=Phase 2 以降

# ── AI基盤 ────────────────────────────────────────────────
# [✓] Claude。アプリ本体のAI機能、CIのコードレビュー、自律開発ループが使用。
#     GitHub Secrets 名も同じ: ANTHROPIC_API_KEY
ANTHROPIC_API_KEY=

# [ ] 朝会の文字起こし済みテキストの処理用（議事録サマリー＋クエスト候補＋ナレッジ候補の抽出）
#     アプリは録音データを扱わず、入力は文字起こし済みテキストのみ（v13 §9 #63 / 2026-09-05 決定）
#     GOOGLE_API_KEY は設定しない。SDK が両方を読み、あれば GOOGLE_API_KEY を優先するため
GEMINI_API_KEY=

# ── CI・自動化（GitHub Actions）────────────────────────────
# ⚠️ この節の値は .env ではなく GitHub Secrets に入れる。ローカルの .env には不要。
#     Settings → Secrets and variables → Actions → New repository secret
#
# [✓] 自律開発ループ（auto-01-plan.yml）が Issue/PR 操作と push に使う Personal Access Token。
#     必要スコープ: repo, workflow
#     ⚠️ GITHUB_TOKEN（自動発行）ではなく PAT が必要な理由:
#        claude-code-action のステップを経由すると checkout の認証情報が失われるため、
#        push 直前に明示的に張り直している（コミット 88256b3）
AUTOMATION_PAT=

# ── Supabase（認証・DB・認可の単一ソース・オブ・トゥルース）──────────────
# [✓] 取得済み（2026-09-13）。WBS 1-1「Supabaseプロジェクト作成」完了。
#     ブラウザに露出してよい公開値（RLS前提）。GitHub Secrets にも同名で登録済み。
#     ⚠️ 「公開値だから Secrets に入れなくてよい」ではない。値が環境ごとに違うため入れる。
#     会員データを守っているのはキーの秘匿ではなく RLS 1枚である（src/lib/supabase/client.ts）
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [✓] サーバサイド専用。RLSを迂回する強力なキーのため、
#     Edge Function / Server Actions 以外では絶対に読まない（CLAUDE.md §3.2）
#     ⚠️ GitHub Secrets には登録しない（CI に service_role は不要）
#     ✅ 2026-09-16〜 使用中。読むのは src/lib/supabase/admin.ts の1箇所だけ。
#        用途は WBS 2-1b の2つ（初回ログインの auth_user_id 結合／招待の送信と台帳記録）で、
#        いずれも RLS 越しには書けない経路である（理由は admin.ts の docstring）。
#        ⚠️ NEXT_PUBLIC_ 接頭辞を付けないことが唯一の防壁。変数名を変えないこと。
#        server.ts は service_role クライアントを「意図的に置かない」と明記している
#        ——「とりあえず service_role で通す」実装を誘発し、唯一の防壁である RLS が
#        無効化されるため。必要になった時点で用途を限定した別モジュールとして起票する。
#        （WBS 2-1b 実装前の注記。上の ✅ のとおり現在は使用中。）
SUPABASE_SERVICE_ROLE_KEY=

# [ ] DB 接続文字列（マイグレーション適用・DBテスト用）。
#     ⚠️ パスワードを含む最も強い値。git には絶対に入れない（CLAUDE.md §3.1）
#     用途は2つ:
#       ① npx supabase db push --db-url "$SUPABASE_DB_URL"
#          … 実プロジェクト（dev/prod）へマイグレーションを適用する。
#            CLAUDE.md §6.3 により自動適用しない。必ず --dry-run で確認してから実行する
#       ② npx jest tests/db … DBテストの接続先（tests/db/helpers/psql.ts:15）
#          未設定だと DB テストは全件 skip される。skip は緑に見えるため気づけない
#          （CI 側で接続先が必ず与えられることを tests/db-test-infra.test.ts が固定している）
#     取得: ダッシュボード → Project Settings → Database → Connection string → URI
#     ⚠️ パスワードに記号を含む場合は percent-encode が必要（CLI の --db-url 要件）
#     ⚠️ ローカルスタック（supabase start）を使う場合はこの値ではなく
#        npx supabase status -o env が返す DB_URL を使う（CI と同じ作法／ci.yml:279-282）
SUPABASE_DB_URL=

# [ ] E2E テスト専用の Supabase プロジェクト（GitHub Secrets のみ）。
#     ⚠️ ここに本番の値を入れると実名370名の会員データに対してテストが走る（CLAUDE.md §6.2）
# E2E_SUPABASE_URL / E2E_SUPABASE_ANON_KEY

# ── LINE Messaging API（通知）────────────────────────────────
# [ ] v13 §5 の通知基盤
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── Cloud Storage for Firebase（メディア）────────────────────
# [ ] Firebase Authentication は使用しない。認可はSupabaseに一元化（v13 §5.11.2）
GCP_PROJECT_ID=
GCS_BUCKET_PRIVATE=
GCS_BUCKET_PUBLIC=
# サービスアカウント鍵はJSONファイルを置かず、鍵の中身を環境変数に入れる
GCP_SERVICE_ACCOUNT_JSON=

# ── 署名付きURLのTTL（分）。v13 §5.11.2 の決定値 ────────────────
# 実値ではなく仕様上の定数のため、ここに書いてよい
SIGNED_URL_UPLOAD_TTL_MIN=10
SIGNED_URL_VIEW_TTL_MIN=5
SIGNED_URL_INTERNAL_KNOWLEDGE_TTL_MIN=2

# ── line-rag-bot 連携 ───────────────────────────────────────
# [P2] Phase 1 では API 連携を実装しない（9-2 は外部リンクのみ）。
#      ⚠️ v13 v1.19.0（2026-08-29）で「API連携を一切実装しない」は撤回され、
#         「Phase 2 以降で実施」へ変更された。恒久的に不要なわけではないためキー名を残す
# LINE_RAG_BOT_ENDPOINT=
# LINE_RAG_BOT_API_KEY=
